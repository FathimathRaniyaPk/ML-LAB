
# NAIVE BAYES CLASSIFICATION USING 20 NEWSGROUPS DATASET



# SECTION 1: Import libraries

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

from sklearn.datasets import fetch_20newsgroups
from sklearn.feature_extraction.text import CountVectorizer

from sklearn.naive_bayes import (
    MultinomialNB,
    BernoulliNB
)

from sklearn.metrics import (
    accuracy_score,
    f1_score,
    classification_report
)



# SECTION 2: Load the 20 Newsgroups dataset

train_data = fetch_20newsgroups(
    subset='train',
    remove=('headers', 'footers', 'quotes')
)

test_data = fetch_20newsgroups(
    subset='test',
    remove=('headers', 'footers', 'quotes')
)

print("Number of training documents:",
      len(train_data.data))

print("Number of testing documents:",
      len(test_data.data))

print("Number of categories:",
      len(train_data.target_names))

# SECTION 3: Display categories


print("\nCategories:")

for i, category in enumerate(train_data.target_names):
    print(i, category)



# SECTION 4: Display a sample document

print("\nSample Document:")
print(train_data.data[0])

print("\nSample Document Category:")
print(
    train_data.target_names[
        train_data.target[0]
    ]
)

# SECTION 5: Convert text into numerical features

vectorizer = CountVectorizer(
    stop_words='english',
    max_features=20000
)

# Fit on training data
X_train = vectorizer.fit_transform(
    train_data.data
)

# Transform test data
X_test = vectorizer.transform(
    test_data.data
)

y_train = train_data.target
y_test = test_data.target

print("\nTraining feature shape:",
      X_train.shape)

print("Testing feature shape:",
      X_test.shape)


# SECTION 6: Multinomial Naive Bayes

mnb = MultinomialNB()

# Train
mnb.fit(X_train, y_train)

# Predict
y_pred_mnb = mnb.predict(X_test)



# SECTION 7: Evaluate Multinomial NB

mnb_accuracy = accuracy_score(
    y_test,
    y_pred_mnb
)

mnb_f1 = f1_score(
    y_test,
    y_pred_mnb,
    average='macro'
)

print("\n==============================")
print("MULTINOMIAL NAIVE BAYES")
print("==============================")

print("Accuracy:",
      round(mnb_accuracy, 4))

print("Macro F1-score:",
      round(mnb_f1, 4))

print("\nClassification Report:")

print(
    classification_report(
        y_test,
        y_pred_mnb,
        target_names=test_data.target_names
    )
)



# SECTION 8: Convert features to binary

X_train_binary = (
    X_train > 0
).astype(int)

X_test_binary = (
    X_test > 0
).astype(int)


# SECTION 9: Bernoulli Naive Bayes

bnb = BernoulliNB()

# Train
bnb.fit(
    X_train_binary,
    y_train
)

# Predict
y_pred_bnb = bnb.predict(
    X_test_binary
)



# SECTION 10: Evaluate Bernoulli NB

bnb_accuracy = accuracy_score(
    y_test,
    y_pred_bnb
)

bnb_f1 = f1_score(
    y_test,
    y_pred_bnb,
    average='macro'
)

print("\n==============================")
print("BERNOULLI NAIVE BAYES")
print("==============================")

print("Accuracy:",
      round(bnb_accuracy, 4))

print("Macro F1-score:",
      round(bnb_f1, 4))

print("\nClassification Report:")

print(
    classification_report(
        y_test,
        y_pred_bnb,
        target_names=test_data.target_names
    )
)



# SECTION 11: Compare both models

results = pd.DataFrame({
    'Model': [
        'Multinomial Naive Bayes',
        'Bernoulli Naive Bayes'
    ],

    'Accuracy': [
        mnb_accuracy,
        bnb_accuracy
    ],

    'F1 Score': [
        mnb_f1,
        bnb_f1
    ]
})

print("\n==============================")
print("MODEL COMPARISON")
print("==============================")

print(results)


# SECTION 12: Plot comparison

results.set_index(
    'Model'
)[['Accuracy', 'F1 Score']].plot(
    kind='bar',
    figsize=(8, 5)
)

plt.title(
    'Multinomial NB vs Bernoulli NB'
)

plt.ylabel('Score')

plt.ylim(0, 1)

plt.xticks(rotation=0)

plt.grid(
    axis='y',
    linestyle='--',
    alpha=0.7
)

plt.tight_layout()

plt.show()

